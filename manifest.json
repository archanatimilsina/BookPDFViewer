{
  "manifest_version": 2,
  "name": "Book PDF Viewer",
  "version": "1.0.0",
  "description": "Detects PDF files as you browse and opens them in a flippable book-style viewer instead of the default scrolling PDF page. Runs entirely locally; no data is collected or transmitted.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": ["shortlink.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Book PDF Viewer",
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "viewer.html",
    "viewer.js",
    "shortlink.js",
    "style.css",
    "pdfjs/*",
    "pdfjs/cmaps/*",
    "pdfjs/standard_fonts/*",
    "icons/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bookpdfviewer@hana.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}